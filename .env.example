# Copy to .env and fill in. Loaded by pydantic-settings; the app fails fast if required vars are missing.

# --- Environment ---
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO

# --- Supabase (auth + DB) ---
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Audience claim Supabase puts in user JWTs (default "authenticated").
SUPABASE_JWT_AUDIENCE=authenticated
# Async SQLAlchemy DSN to the SAME Postgres. Use the direct connection (Settings > Database).
# Format: postgresql+asyncpg://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.YOUR-PROJECT-ref.supabase.co:5432/postgres

# --- LLM provider: Google Gemini via Vertex AI Express (server-side only — NEVER ship to the client) ---
# Express-mode API key (AQ.-prefixed) from https://console.cloud.google.com/vertex-ai/studio
GEMINI_API_KEY=AQ...
# Express-mode projects expose 2.5 models (gemini-2.5-flash | gemini-2.5-pro).
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024

# --- Cost control ---
COACHING_RATE_LIMIT_PER_HOUR=10

# --- CORS (comma-separated). The Android app uses no origin; lock this to your web/admin origins. ---
CORS_ORIGINS=

# --- Observability (optional) ---
SENTRY_DSN=
